        {
          "ruleId": "CWE-22: Improper Limitation of a Pathname to a Restricted Directory (Path Traversal)",
          "level": "error",
          "message": {
            "text": "Path Traversal Vulnerability in ReplayFileReader  [CVSS 7.5: CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N]"
          },
          "locations": [
            {
              "physicalLocation": {
