        {
          "ruleId": "CWE-711",
          "level": "error",
          "message": {
            "text": "Improper Input Validation in ProcessMessage Function  [CVSS 7.5: CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lib/marketState/MarketState.js"
                },
                "region": {
                  "startLine": 303
                }
              },
              "logicalLocations": [
